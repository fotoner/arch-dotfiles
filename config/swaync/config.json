{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "top",
  "layer-shell": true,
  "cssPriority": "user",
  "control-center-margin-top": 8,
  "control-center-margin-bottom": 10,
  "control-center-margin-right": 10,
  "control-center-width": 420,
  "notification-window-width": 400,
  "fit-to-screen": true,
  "timeout": 6,
  "timeout-low": 4,
  "timeout-critical": 0,
  "keyboard-shortcuts": true,
  "notification-grouping": true,
  "image-visibility": "when-available",
  "transition-time": 200,
  "hide-on-clear": false,
  "hide-on-action": true,
  "relative-timestamps": true,
  "text-empty": "알림 없음",
  "widgets": [
    "buttons-grid",
    "volume",
    "backlight",
    "mpris",
    "title",
    "dnd",
    "notifications"
  ],
  "widget-config": {
    "title": {
      "text": "알림",
      "clear-all-button": true,
      "button-text": "모두 지우기"
    },
    "dnd": {
      "text": "방해 금지"
    },
    "volume": {
      "label": "󰕾"
    },
    "backlight": {
      "label": "󰃟",
      "device": "intel_backlight"
    },
    "mpris": {
      "show-album-art": "always",
      "autohide": true
    },
    "buttons-grid": {
      "buttons-per-row": 5,
      "actions": [
        {
          "label": "󰖩",
          "command": "~/.config/hypr/scripts/quick-toggle.sh wifi"
        },
        {
          "label": "󰂯",
          "command": "~/.config/hypr/scripts/quick-toggle.sh bluetooth"
        },
        {
          "label": "󰍬",
          "command": "~/.config/hypr/scripts/quick-toggle.sh mic"
        },
        {
          "label": "󰄀",
          "command": "sh -c 'swaync-client -cp; sleep 0.3; ~/.config/hypr/scripts/screenshot.sh area'"
        },
        {
          "label": "󰐥",
          "command": "sh -c 'swaync-client -cp; nwg-bar'"
        }
      ]
    }
  }
}
