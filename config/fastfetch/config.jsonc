// fastfetch: 왼쪽에 원형 프로필 사진(~/.face로 face.sh가 만든 그림), 오른쪽에 상자 하나에 시스템 · 데스크톱 · 하드웨어 세 묶음.
// 항목 이름 글자 없이 아이콘만 (아이콘 색이 묶음 색: mauve · blue · green). 색은 Catppuccin Mocha. 사진이 없으면 기본 Arch 로고가 나온다
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "kitty-direct",
    "source": "~/.cache/fastfetch/face.png",
    "width": 24,
    "height": 11,
    "padding": { "top": 6, "left": 2, "right": 4 }
  },
  "display": {
    "separator": "",
    "key": { "width": 6 },
    "color": { "keys": "#cba6f7", "output": "#cdd6f4" },
    "percent": {
      "type": 11,
      "color": { "green": "#a6e3a1", "yellow": "#f9e2af", "red": "#f38ba8" }
    },
    "bar": {
      "char": { "elapsed": "━", "total": "━" },
      "border": { "left": "", "right": "" },
      "color": { "elapsed": "#a6e3a1", "total": "#45475a" },
      "width": 12
    },
    "size": { "binaryPrefix": "jedec", "ndigits": 1 }
  },
  "modules": [
    "break",
    {
      "type": "title",
      "format": "{#1;38;2;203;166;247}{user-name}{#0;38;2;108;112;134} @ {#1;38;2;137;180;250}{host-name}"
    },
    "break",

    { "type": "custom", "format": "{#38;2;69;71;90}╭──────────────────────────────────────────────────" },
    { "type": "os", "key": "{#38;2;69;71;90}│ {#38;2;203;166;247}󰣇", "format": "{pretty-name} {arch}" },
    { "type": "kernel", "key": "{#38;2;69;71;90}│ {#38;2;203;166;247}󰌽", "format": "{release}" },
    { "type": "uptime", "key": "{#38;2;69;71;90}│ {#38;2;203;166;247}󰅐", "format": "{?days}{days}d {?}{?hours}{hours}h {?}{minutes}m" },
    { "type": "packages", "key": "{#38;2;69;71;90}│ {#38;2;203;166;247}󰏖", "format": "{pacman} (pacman){?flatpak-all} · {flatpak-all} (flatpak){?}{?appimage} · {appimage} (AppImage){?}" },
    { "type": "shell", "key": "{#38;2;69;71;90}│ {#38;2;203;166;247}󰆍", "format": "{pretty-name} {version}" },

    { "type": "custom", "format": "{#38;2;69;71;90}├──────────────────────────────────────────────────" },
    { "type": "wm", "key": "{#38;2;69;71;90}│ {#38;2;137;180;250}󰕮", "format": "{pretty-name} {version}" },
    { "type": "terminal", "key": "{#38;2;69;71;90}│ {#38;2;137;180;250}󰞷", "format": "{pretty-name} {version}" },
    { "type": "display", "key": "{#38;2;69;71;90}│ {#38;2;137;180;250}󰍹", "format": "{width}×{height} @ {refresh-rate} Hz" },

    { "type": "custom", "format": "{#38;2;69;71;90}├──────────────────────────────────────────────────" },
    { "type": "cpu", "key": "{#38;2;69;71;90}│ {#38;2;166;227;161}󰻠", "format": "{name} ({cores-logical}) @ {freq-max}" },
    { "type": "gpu", "key": "{#38;2;69;71;90}│ {#38;2;166;227;161}󰾲", "format": "{vendor} {name}" },
    { "type": "memory", "key": "{#38;2;69;71;90}│ {#38;2;166;227;161}󰍛", "format": "{percentage-bar}  {used} / {total} {percentage}" },
    { "type": "disk", "key": "{#38;2;69;71;90}│ {#38;2;166;227;161}󰋊", "folders": "/", "format": "{size-percentage-bar}  {size-used} / {size-total} {size-percentage}" },
    { "type": "battery", "key": "{#38;2;69;71;90}│ {#38;2;166;227;161}󰁹", "format": "{capacity-bar}  {capacity}" },
    { "type": "custom", "format": "{#38;2;69;71;90}╰──────────────────────────────────────────────────" },

    "break",
    { "type": "colors", "paddingLeft": 2, "symbol": "circle" }
  ]
}
