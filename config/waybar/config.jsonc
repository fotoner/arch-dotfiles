{
  "layer": "top",
  "position": "top",
  "height": 30,
  "spacing": 8,
  "modules-left": ["hyprland/workspaces"],
  "modules-center": ["clock"],
  "modules-right": ["tray", "power-profiles-daemon", "pulseaudio", "network", "battery"],

  "clock": {
    "format": "{:%m/%d %H:%M}",
    "tooltip-format": "<tt>{calendar}</tt>"
  },
  "power-profiles-daemon": {
    "format": "{profile}",
    "tooltip-format": "전원 모드: {profile} (클릭해서 바꾸기)"
  },
  "pulseaudio": {
    "format": "VOL {volume}%",
    "format-muted": "MUTE",
    "on-click": "pavucontrol"
  },
  "network": {
    "format-wifi": "WiFi {essid}",
    "format-ethernet": "LAN",
    "format-disconnected": "오프라인",
    "tooltip-format": "{ifname} {ipaddr}",
    "on-click": "nm-connection-editor"
  },
  "battery": {
    "format": "BAT {capacity}%",
    "format-charging": "BAT {capacity}% +",
    "states": { "warning": 25, "critical": 10 }
  },
  "tray": {
    "spacing": 8
  }
}
